{
  "$schema": "./config.schema.json",
  "version": "1.0",
  "team": {
    "name": "Training",
    "reviewers": []
  },
  "repo": {
    "backend": "github",
    "org": "elsabe123",
    "name": "address-book-app-em",
    "base_branch": "main",
    "branch_prefix": "feature/",
    "commit_style": "conventional"
  },
  "tools": {
    "gh_path": "gh",
    "az_path": "az"
  },
  "workflow": {
    "gates": ["spec", "plan", "pr"],
    "fast_track_enabled": true,
    "max_retries_per_stage": 3,
    "max_test_review_loops": 5,
    "parallel_tests": true,
    "auto_document": true
  },
  "pr_template": "built-in"
}
